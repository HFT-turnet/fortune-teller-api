{
  "flow": {
    "id": "DE_gen",
    "version": "1.0",
    "description": "Generische Items für mehrere Planitem-Typen in Deutschland.",
    "scope": "DE",
    "items": {
      "cash_start": {
        "name": "cash_start",
        "label": "Vermögen zu Beginn",
        "required": false,
        "description": "Optional: Wenn positive Bargeld-, Konto- oder Depotbestände bestehen.",
        "icon": "fas fa-piggy-bank",
        "checklist_entry": "Vermögen zu Beginn angeben (optional)",
        "actions": {
          "cvalue_cash": {
            "api": {
              "version": "v1",
              "path": "/entry?type=Cvalue",
              "method": "POST",
              "payload": {
                  "cvalue": {
                              "cvaluetype": 3,
                              "label": "Bargeld / Giro",
                              "cto": 0,
                              "planitem_id": "9",
                              "t": "1990",
                              "fromt": "1990",
                              "tot": "2100",
                              "interest": 0
                          }
                }
              },
            "fields": {
              "ev": {
                "type": "decimal",
                "label": "Kontostand",
                "help": "Bargeldbestand eingeben bitte."
              }
            },
            "include_fields_in_payload_within": "cvalue"
          },
          "cvalue_tagesgeld": {
            "api": {
              "version": "v1",
              "path": "/entry?type=Cvalue",
              "method": "POST",
              "payload": {
                  "cvalue": {
                              "cvaluetype": 3,
                              "label": "Bargeld / Giro",
                              "cto": 0,
                              "planitem_id": "9",
                              "t": 1990,
                              "fromt": 2025,
                              "tot": 2090
                          }
                }
              },
            "fields": {
              "ev": {
                "type": "decimal",
                "label": "Kontostand Tagesgeld",
                "help": "Bargeldbestand eingeben bitte."
              },             
              "interest": {
                "type": "decimal",
                "label": "Zinssatz Tagesgeld",
                "help": "Zinssatz für Tagesgeld eingeben bitte."
              }
            },
            "include_fields_in_payload_within": "cvalue"
          },
          "cvalue_depot": {
            "api": {
              "version": "v1",
              "path": "/entry?type=Cvalue",
              "method": "POST",
              "payload": {
                  "cvalue": {
                              "cvaluetype": 3,
                              "label": "Bargeld / Giro",
                              "cto": 0,
                              "planitem_id": "9",
                              "t": "var_fromt",
                              "fromt": "var_planitem_fromt",
                              "tot": "var_planitem_tot",
                              "interest": 0
                          }
                }
              },
            "fields": {
              "ev": {
                "type": "decimal",
                "label": "Depotbestand",
                "help": "Bargeldbestand eingeben bitte."
              }
            },
            "include_fields_in_payload_within": "cvalue"
          }
        }
      }
    }
  }
}