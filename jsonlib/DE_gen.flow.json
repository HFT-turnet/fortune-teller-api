{
  "flow": {
    "id": "DE_gen",
    "version": "1.0",
    "description": "Generische Items für mehrere Planitem-Typen in Deutschland.",
    "scope": "DE",
    "type": "planitem",
    "planitem_type": 99,
    "icon": "fas fa-cogs",
    "items": {
      "cash_start": {
        "name": "cash_start",
        "label": "Vermögen zu Beginn",
        "required": false,
        "description": "Optional: Wenn positive Bargeld-, Konto- oder Depotbestände bestehen.",
        "icon": "fas fa-piggy-bank",
        "checklist_entry": "Vermögen zu Beginn angeben (optional)",
        "variables": [
          "var_planitem_id",
          "var_planitem_fromt"
        ],
        "actions": {
          "cvalue_cash": {
            "api": {
              "version": "v1",
              "path": "/entry?type=Cvalue",
              "method": "POST",
              "payload": {
                  "cvalue": {
                              "cvaluetype": 3,
                              "label": "Bargeld / Giro",
                              "cto": 0,
                              "ev": "field_cash_ev",
                              "planitem_id": "var_planitem_id",
                              "t": "var_planitem_fromt",
                              "fromt": "var_planitem_fromt",
                              "tot": "var_planitem_fromt",
                              "interest": 0
                          }
                }
              },
            "fields": {
              "cash_ev": {
                "type": "decimal",
                "label": "Kontostand",
                "help": "Bargeldbestand eingeben bitte."
              }
            }
          },
          "cvalue_tagesgeld": {
            "api": {
              "version": "v1",
              "path": "/entry?type=Cvalue",
              "method": "POST",
              "payload": {
                  "cvalue": {
                              "cvaluetype": 3,
                              "label": "Bargeld / Tagesgeld",
                              "cto": 0,
                              "ev": "field_cashtg_ev",
                              "planitem_id":"var_planitem_id",
                              "t": "var_planitem_fromt",
                              "fromt": "var_planitem_fromt",
                              "tot": "var_planitem_fromt",
                              "interest": "field_cashtg_interest"
                          }
                }
              },
            "fields": {
              "cashtg_ev": {
                "type": "decimal",
                "label": "Kontostand Tagesgeld",
                "help": "Bargeldbestand eingeben bitte."
              },             
              "cashtg_interest": {
                "type": "decimal",
                "label": "Zinssatz Tagesgeld",
                "help": "Zinssatz für Tagesgeld eingeben bitte.",
                "secondary_field": true
              }
            }
          },
          "cvalue_depot": {
            "api": {
              "version": "v1",
              "path": "/entry?type=Cvalue",
              "method": "POST",
              "payload": {
                  "cvalue": {
                              "cvaluetype": 3,
                              "label": "Bargeld / Depot",
                              "cto": 0,
                              "ev": "field_depot_ev",
                              "planitem_id": "var_planitem_id",
                              "t": "var_planitem_fromt",
                              "fromt": "var_planitem_fromt",
                              "tot": "var_planitem_fromt",
                              "interest": "field_depot_interest"
                          }
                }
              },
            "fields": {
              "depot_ev": {
                "type": "decimal",
                "label": "Depotbestand",
                "help": "Bargeldbestand eingeben bitte."
              },             
              "depot_interest": {
                "type": "decimal",
                "label": "Rendite Depot (netto)",
                "help": "Rendite für Depot eingeben bitte.",
                "secondary_field": true
              }
            }
          }
        }
      },
      "expenses": {
        "name": "expenses",
        "label": "Laufende Ausgaben",
        "required": false,
        "description": "Erfassen Sie Ausgabenblöcke mit jeweils eigener Inflation.",
        "icon": "fas fa-receipt",
        "checklist_entry": "Laufende Ausgaben erfassen (optional)",
        "variables": [
          "var_current_year",
          "var_planitem_id",
          "var_planitem_fromt",
          "var_planitem_tot"
        ],
        "actions": {
          "cslice_expenses": {
            "api": {
              "version": "v1",
              "path": "/entry?type=Cslice",
              "method": "POST",
              "payload": {
                "cslice": {
                  "cvaluetype": 2,
                  "label": "Lebenshaltungskosten",
                  "planitem_id": "var_planitem_id",
                  "t": "var_current_year",
                  "source": "Flow: expenses",
                  "info": "Created by generic expenses flow",
                  "cvalues": [
                    {
                      "planitem_id": "var_planitem_id",
                      "cvaluetype": 2,
                      "label": "Nahrungsmittel, Getränke und Tabakwaren",
                      "cto": "field_food_tobacco_cto",
                      "ev": 0,
                      "t": "var_current_year",
                      "fromt": "var_planitem_fromt",
                      "tot": "var_planitem_tot",
                      "inflation": "field_food_tobacco_inflation"
                    },
                    {
                      "planitem_id": "var_planitem_id",
                      "cvaluetype": 2,
                      "label": "Bekleidung und Schuhe",
                      "cto": "field_clothing_cto",
                      "ev": 0,
                      "t": "var_current_year",
                      "fromt": "var_planitem_fromt",
                      "tot": "var_planitem_tot",
                      "inflation": "field_clothing_inflation"
                    },
                    {
                      "planitem_id": "var_planitem_id",
                      "cvaluetype": 2,
                      "label": "Wohnung, Wasser, Strom, Gas und andere Brennstoffe",
                      "cto": "field_housing_energy_cto",
                      "ev": 0,
                      "t": "var_current_year",
                      "fromt": "var_planitem_fromt",
                      "tot": "var_planitem_tot",
                      "inflation": "field_housing_energy_inflation"
                    },
                    {
                      "planitem_id": "var_planitem_id",
                      "cvaluetype": 2,
                      "label": "Einrichtungsgegenstände (Möbel), Hausrat, Instandhaltung",
                      "cto": "field_home_goods_cto",
                      "ev": 0,
                      "t": "var_current_year",
                      "fromt": "var_planitem_fromt",
                      "tot": "var_planitem_tot",
                      "inflation": "field_home_goods_inflation"
                    },
                    {
                      "planitem_id": "var_planitem_id",
                      "cvaluetype": 2,
                      "label": "Gesundheit",
                      "cto": "field_health_cto",
                      "ev": 0,
                      "t": "var_current_year",
                      "fromt": "var_planitem_fromt",
                      "tot": "var_planitem_tot",
                      "inflation": "field_health_inflation"
                    },
                    {
                      "planitem_id": "var_planitem_id",
                      "cvaluetype": 2,
                      "label": "Verkehr",
                      "cto": "field_transport_cto",
                      "ev": 0,
                      "t": "var_current_year",
                      "fromt": "var_planitem_fromt",
                      "tot": "var_planitem_tot",
                      "inflation": "field_transport_inflation"
                    },
                    {
                      "planitem_id": "var_planitem_id",
                      "cvaluetype": 2,
                      "label": "Information und Kommunikation",
                      "cto": "field_information_communication_cto",
                      "ev": 0,
                      "t": "var_current_year",
                      "fromt": "var_planitem_fromt",
                      "tot": "var_planitem_tot",
                      "inflation": "field_information_communication_inflation"
                    },
                    {
                      "planitem_id": "var_planitem_id",
                      "cvaluetype": 2,
                      "label": "Freizeit, Sport und Kultur",
                      "cto": "field_leisure_culture_cto",
                      "ev": 0,
                      "t": "var_current_year",
                      "fromt": "var_planitem_fromt",
                      "tot": "var_planitem_tot",
                      "inflation": "field_leisure_culture_inflation"
                    },
                    {
                      "planitem_id": "var_planitem_id",
                      "cvaluetype": 2,
                      "label": "Gastronomie- und Beherbergungsdienstleistungen",
                      "cto": "field_hospitality_cto",
                      "ev": 0,
                      "t": "var_current_year",
                      "fromt": "var_planitem_fromt",
                      "tot": "var_planitem_tot",
                      "inflation": "field_hospitality_inflation"
                    },
                    {
                      "planitem_id": "var_planitem_id",
                      "cvaluetype": 2,
                      "label": "Bildung, Versicherungen und sonstige Waren und DL",
                      "cto": "field_education_insurance_other_cto",
                      "ev": 0,
                      "t": "var_current_year",
                      "fromt": "var_planitem_fromt",
                      "tot": "var_planitem_tot",
                      "inflation": "field_education_insurance_other_inflation"
                    }
                  ]
                }
              }
            },
            "fields": {
              "food_tobacco_cto": {
                "type": "decimal",
                "label": "Nahrungsmittel, Getränke und Tabakwaren (jährlich)",
                "default": 3048
              },
              "food_tobacco_inflation": {
                "type": "decimal",
                "label": "Inflation Nahrungsmittel, Getränke und Tabakwaren",
                "default": 0.026,
                "secondary_field": true
              },
              "clothing_cto": {
                "type": "decimal",
                "label": "Bekleidung und Schuhe (jährlich)",
                "default": 720
              },
              "clothing_inflation": {
                "type": "decimal",
                "label": "Inflation Bekleidung und Schuhe",
                "default": 0.008,
                "secondary_field": true
              },
              "housing_energy_cto": {
                "type": "decimal",
                "label": "Wohnung, Wasser, Strom, Gas und andere Brennstoffe (jährlich)",
                "default": 9804
              },
              "housing_energy_inflation": {
                "type": "decimal",
                "label": "Inflation Wohnung, Wasser, Strom, Gas und andere Brennstoffe",
                "default": 0.014,
                "secondary_field": true
              },
              "home_goods_cto": {
                "type": "decimal",
                "label": "Einrichtungsgegenstände (Möbel), Hausrat, Instandhaltung (jährlich)",
                "default": 924
              },
              "home_goods_inflation": {
                "type": "decimal",
                "label": "Inflation Einrichtungsgegenstände (Möbel), Hausrat, Instandhaltung",
                "default": 0,
                "secondary_field": true
              },
              "health_cto": {
                "type": "decimal",
                "label": "Gesundheit (jährlich)",
                "default": 732
              },
              "health_inflation": {
                "type": "decimal",
                "label": "Inflation Gesundheit",
                "default": 0.028,
                "secondary_field": true
              },
              "transport_cto": {
                "type": "decimal",
                "label": "Verkehr (jährlich)",
                "default": 2340
              },
              "transport_inflation": {
                "type": "decimal",
                "label": "Inflation Verkehr",
                "default": 0.018,
                "secondary_field": true
              },
              "information_communication_cto": {
                "type": "decimal",
                "label": "Information und Kommunikation (jährlich)",
                "default": 1296
              },
              "information_communication_inflation": {
                "type": "decimal",
                "label": "Inflation Information und Kommunikation",
                "default": -0.007,
                "secondary_field": true
              },
              "leisure_culture_cto": {
                "type": "decimal",
                "label": "Freizeit, Sport und Kultur (jährlich)",
                "default": 1788
              },
              "leisure_culture_inflation": {
                "type": "decimal",
                "label": "Inflation Freizeit, Sport und Kultur",
                "default": 0.013,
                "secondary_field": true
              },
              "hospitality_cto": {
                "type": "decimal",
                "label": "Gastronomie- und Beherbergungsdienstleistungen (jährlich)",
                "default": 1356
              },
              "hospitality_inflation": {
                "type": "decimal",
                "label": "Inflation Gastronomie- und Beherbergungsdienstleistungen",
                "default": 0.038,
                "secondary_field": true
              },
              "education_insurance_other_cto": {
                "type": "decimal",
                "label": "Bildung, Versicherungen und sonstige Waren und DL (jährlich)",
                "default": 996
              },
              "education_insurance_other_inflation": {
                "type": "decimal",
                "label": "Inflation Bildung, Versicherungen und sonstige Waren und DL",
                "default": 0.05,
                "secondary_field": true
              }
            }
          }
        }
      },
      "salary_sequence": {
        "name": "salary_sequence",
        "label": "Gehalt berechnen & speichern",
        "description": "Zuerst Bruttogehalt eingeben, dann Ergebnisse speichern",
        "icon": "fas fa-coins",
        "checklist_entry": "Gehalt berechnen und einplanen",
        "actions": {
          "a_grossnet": {
            "order": 1,
            "label": "Schritt 1: Bruttogehalt berechnen",
            "description": "Berechnet Netto aus Brutto (SV + Steuern)",
            "api": {
              "version": "v1",
              "path": "/public/grossnet",
              "method": "POST",
              "payload": { "gross_salary": "var_gross_salary", "sv-westost": "sv-west" }
            },
            "fields": {
              "gross_salary": {
                "type": "decimal",
                "label": "Bruttogehalt (Jährlich)",
                "help": "Geben Sie Ihr jährliches Bruttogehalt ein",
                "required": true
              }
            },
            "result_presentation": {
              "bruttogehalt": "Bruttogehalt",
              "sv_alv12": "Arbeitslosenversicherung",
              "sv_gkv_an12": "Gesetzliche Krankenversicherung",
              "sv_pv_an12": "Pflegeversicherung",
              "sv_drv12": "Rentenversicherung",
              "est": "Einkommensteuer",
              "soli": "Solidaritätszuschlag"
            },
            "show_results": true,
            "next_action": "b_save"
            },
          "b_save": {
            "order": 2,
            "label": "Schritt 2: Einkommen einplanen",
            "description": "Speichern Sie die berechneten Werte mit Zeitraum und Inflation",
            "api": {
              "version": "v1",
              "path": "/entry",
              "method": "POST",
              "payload": {
                "cslice": {
                  "cvaluetype": 1,
                  "label": "Arbeitseinkommen",
                  "planitem_id": "1",
                  "t": "var_current_year",
                  "source": "Flow: Salary",
                  "info": "Created by flow sequence",
                  "cvalues": [
                    {
                      "planitem_id": "1",
                      "cvaluetype": 1,
                      "label": "Bruttoeinkommen",
                      "cto": "var_gross",
                      "ev": 0,
                      "t": "var_current_year",
                      "fromt": "var_fromt",
                      "tot": "var_tot",
                      "inflation": "var_inflation"
                    },
                    {
                      "planitem_id": "1",
                      "cvaluetype": 2,
                      "label": "Sozialversicherung",
                      "cto": "var_sum_sv",
                      "ev": 0,
                      "t": "var_current_year",
                      "fromt": "var_fromt",
                      "tot": "var_tot",
                      "inflation": "var_inflation"
                    },
                    {
                      "planitem_id": "1",
                      "cvaluetype": 2,
                      "label": "Steuern",
                      "cto": "var_sum_tax",
                      "ev": 0,
                      "t": "var_current_year",
                      "fromt": "var_fromt",
                      "tot": "var_tot",
                      "inflation": "var_inflation"
                    }
                  ]
                }
              }
            },
            "fields": {
              "fromt": {
                "type": "integer",
                "label": "Berufsbeginn (Jahr)",
                "default": 2025
              },
              "tot": {
                "type": "integer",
                "label": "Berufsende (Jahr)",
                "default": 2060
              },
              "inflation": {
                "type": "decimal",
                "label": "Gehaltserhöhung (%)",
                "default": 2.0
              }
            }
          }
        }
      }
    }
  }
}