{
  "flow": {
    "id": "DE_gen",
    "version": "1.0",
    "description": "Generische Items für alle Planitem-Typen in Deutschland.",
    "scope": "DE",
    "type": "base",

    "items": {
      "cash_start": {
        "name": "cash_start",
        "label": "Bargeld zu Beginn",
        "required": false,
        "description": "Optional: Wenn positive Bargeld-, Konto- oder Depotbestände bestehen.",
        "icon": "fas fa-piggy-bank",
        "checklist_entry": "Bargeld zu Beginn angeben (optional)",
        "actions": {
          "cslice_cash": {
            "api": {
              "version": "v1",
              "path": "/simulation/cslice"
              },
            "fields": {
              "cash_start": {
                "type": "decimal",
                "label": "Kontostand",
                "help": "Bargeldbestand eingeben bitte."
              }
            }
          },
          "cslice_depot": {
            "api": {
              "version": "v1",
              "path": "/simulation/cslice"
              },
            "fields": {
              "depot_start": {
                "type": "decimal",
                "label": "Depotwert",
                "help": "Depotwert eingeben bitte."
              }
            }
        }
        }
      },

      "bezeichnung": {
        "name": "bezeichnung",
        "label": "Bezeichnung",
        "type": "string",
        "required": true,
        "description": "Name oder Beschreibung des Planitems.",
        "icon": "fas fa-tag",
        "api": {
          "field": "bezeichnung",
          "type": "string"
        },
        "validation": {
          "rules": [
            {
              "condition": "required && min_length(1)",
              "message": "Bezeichnung ist Pflicht und muss mindestens 1 Zeichen lang sein."
            }
          ]
        },
        "checklist_entry": "Bezeichnung angeben"
      },

      "datum": {
        "name": "datum",
        "label": "Datum",
        "type": "date",
        "required": true,
        "format": "YYYY-MM-DD",
        "description": "Datum des Planitems (z. B. Beginn, Kaufdatum).",
        "icon": "fas fa-calendar-alt",
        "api": {
          "field": "datum",
          "type": "date"
        },
        "validation": {
          "rules": [
            {
              "condition": "format(YYYY-MM-DD)",
              "message": "Datum muss im Format YYYY-MM-DD vorliegen."
            }
          ]
        },
        "checklist_entry": "Datum angeben"
      },

      "betrag": {
        "name": "betrag",
        "label": "Betrag",
        "type": "number",
        "required": true,
        "min": 0,
        "description": "Betrag in Euro.",
        "icon": "fas fa-euro-sign",
        "api": {
          "field": "betrag",
          "type": "number"
        },
        "validation": {
          "rules": [
            {
              "condition": ">= 0",
              "message": "Betrag muss größer oder gleich 0 sein."
            }
          ]
        },
        "checklist_entry": "Betrag in Euro angeben"
      }
    }
  }
}